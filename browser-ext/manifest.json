{
  "manifest_version": 3,
  "name": "Augmented Hypermedia",
  "version": "1.0",

  "description": "ahx based addons for any web app",

  "icons": {
    "48": "icons/ahx.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "ahx@gubbins.app",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["init.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "matches": ["*://*/*"],
      "resources": ["/@ahx/*"]
    }
  ]
}
